# Banco PostgreSQL
DB_NAME=imobcontrol
DB_USER=imobcontrol
DB_PASSWORD=troque-por-uma-senha-forte

# Primeiro super administrador do ImobControl
# Usado somente para criar o primeiro usuário caso ele ainda não exista.
IMOB_ADMIN_NAME=Administrador ImobControl
IMOB_ADMIN_EMAIL=admin@exemplo.com
IMOB_ADMIN_PASSWORD=troque-por-uma-senha-forte

# false enquanto estiver acessando apenas por HTTP/IP.
# Troque para true quando o site estiver com HTTPS.
SESSION_COOKIE_SECURE=false

# Porta pública HTTP do proxy
HTTP_PORT=80


# Produção separada (frontend Hostinger -> API externa)
# URL HTTPS pública do backend, sem /api no final.
API_UPSTREAM=https://api.exemplo.com

# Perfil de produção do Spring. Containers do backend já usam prod por padrão.
SPRING_PROFILES_ACTIVE=prod

# Pool de conexões PostgreSQL
DB_POOL_MAX=20
DB_POOL_MIN=2
SESSION_TIMEOUT=12h
