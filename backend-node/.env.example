# PostgreSQL existente. Não utilizar MySQL.
NODE_ENV=production
PORT=3000
SESSION_SECRET=ALTERE_PARA_UMA_CHAVE_UNICA_LONGA_DE_PELO_MENOS_32_CARACTERES
COOKIE_SECURE=true
DATABASE_URL=postgresql://usuario:senha@host:5432/imobcontrol
# Alternativa a DATABASE_URL: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# PGSSL=true # apenas se exigir TLS com certificado valido
